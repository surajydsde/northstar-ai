{
  "name": "chatgpt-clone",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0 -p 3000",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint . --max-warnings=0",
    "db": "docker compose up -d postgres",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "ai:verify": "tsx scripts/verify-provider.ts",
    "smoke:rag": "tsx scripts/smoke-rag.ts",
    "ai:reembed": "tsx scripts/reembed.ts",
    "uploads:migrate": "tsx scripts/migrate-uploads.ts",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:backfill-vectors": "tsx scripts/backfill-pgvector.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@google/genai": "^2.21.0",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.14",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@types/lodash": "^4.17.25",
    "better-auth": "^1.7.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "lodash": "^4.18.1",
    "next": "16.3.3",
    "openai": "^7.10.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/estree": "^1.0.9",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --max-warnings=0"
    ],
    "*.{json,css,yml,yaml,md}": [
      "prettier --write"
    ]
  }
}
